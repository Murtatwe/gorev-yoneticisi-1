<UserControl x:Class="GorevYoneticisi.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:GorevYoneticisi.App.Ui">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CpuColor" Color="#4C9AFF" />
        <SolidColorBrush x:Key="MemColor" Color="#A66CFF" />
        <SolidColorBrush x:Key="GpuColor" Color="#2DC9A0" />
        <SolidColorBrush x:Key="DiskColor" Color="#F5A524" />
        <SolidColorBrush x:Key="DownColor" Color="#E5484D" />
        <SolidColorBrush x:Key="UpColor" Color="#F38BA8" />

        <DataTemplate x:Key="TopItem">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,16">
            <TextBlock Text="Genel Bakış" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}">
                <Run Text="{Binding OsName, Mode=OneWay}" /><Run Text="  ·  Açık kalma süresi: " /><Run Text="{Binding Uptime, Mode=OneWay}" />
                <Run Text="  ·  " /><Run Text="{Binding Counts, Mode=OneWay}" />
            </TextBlock>

            <UniformGrid Columns="2">
                <!-- CPU -->
                <Border Style="{StaticResource Panel}" Margin="0,0,8,12">
                    <StackPanel>
                        <TextBlock Text="İŞLEMCİ (CPU)" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource BigValue}" Margin="0,8,0,4" />
                        <u:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource CpuColor}" Height="90" />
                        <TextBlock Text="{Binding CpuSubtitle}" Style="{StaticResource Caption}" Margin="0,8,0,6" />
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="14" Height="34" Margin="0,0,3,3" CornerRadius="3" ToolTip="{Binding Label}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Border VerticalAlignment="Bottom" CornerRadius="3" Background="{StaticResource CpuColor}"
                                                Height="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=34}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource Panel}" Margin="8,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BELLEK (RAM)" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="Toplam " /><Run Text="{Binding MemoryTotalText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource BigValue}" Margin="0,8,0,4" />
                        <u:Sparkline Values="{Binding MemoryHistory}" Stroke="{StaticResource MemColor}" Height="90" />
                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Panel}" Margin="0,0,8,12">
                    <StackPanel>
                        <TextBlock Text="EKRAN KARTI (GPU)" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource BigValue}" Margin="0,8,0,4" />
                        <u:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource GpuColor}" Height="90" />
                        <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding GpuEngines}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource Panel}" Margin="8,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DİSK" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Etkin zaman (tüm diskler)" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource BigValue}" Margin="0,8,0,4" />
                        <u:Sparkline Values="{Binding DiskHistory}" Stroke="{StaticResource DiskColor}" Height="90" />
                        <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Network -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AĞ · İNDİRME" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding NetDown}" Style="{StaticResource BigValue}" FontSize="22" Margin="0,6,0,4" />
                        <u:Sparkline Values="{Binding DownHistory}" Stroke="{StaticResource DownColor}" AutoScale="True" Height="60" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AĞ · YÜKLEME" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding NetUp}" Style="{StaticResource BigValue}" FontSize="22" Margin="0,6,0,4" />
                        <u:Sparkline Values="{Binding UpHistory}" Stroke="{StaticResource UpColor}" AutoScale="True" Height="60" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top consumers -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK CPU KULLANANLAR" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource TopItem}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK BELLEK KULLANANLAR" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource TopItem}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EN ÇOK GPU KULLANANLAR" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TopGpu}" ItemTemplate="{StaticResource TopItem}" />
                        <TextBlock Text="Şu an GPU kullanan program yok." Style="{StaticResource Caption}"
                                   Visibility="{Binding TopGpu.Count, Converter={StaticResource ZeroToVisible}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
