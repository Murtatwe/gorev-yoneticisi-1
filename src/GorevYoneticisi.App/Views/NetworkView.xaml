<UserControl x:Class="GorevYoneticisi.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ağ" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Hangi programın internete ya da yerel ağa bağlı olduğu. 'Uzak adres', programın bağlandığı bilgisayardır. Tanımadığınız bir programın sürekli dışarıya bağlanması şüphe nedenidir." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <ui:TextBox DockPanel.Dock="Left" Width="320" PlaceholderText="Program, adres ya da PID ile ara…"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Search24}" />
            <CheckBox DockPanel.Dock="Left" Content="Bağlantı bekleyen programları da göster" IsChecked="{Binding ShowListening}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28" SelectionMode="Single"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Program" Width="1.4*" SortMemberPath="ProcessName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0" />
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="80" />
                <DataGridTextColumn Header="Yerel adres" Binding="{Binding Local}" Width="1.2*" />
                <DataGridTextColumn Header="Uzak adres" Binding="{Binding Remote}" Width="1.4*" />
                <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="1*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
