<UserControl x:Class="GorevYoneticisi.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="FindingTemplate">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="4" CornerRadius="2" Margin="0,0,12,0" Background="{Binding Level, Converter={StaticResource RiskBrush}}" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Level, Converter={StaticResource RiskText}}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{Binding Level, Converter={StaticResource RiskBrush}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Body}" FontSize="12" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                        <ui:Button Content="İşlemlerde göster" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.ShowInProcessesCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <ui:Button Content="VirusTotal'de ara" HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.VirusTotalCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,16">
            <TextBlock Text="Güvenlik" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Bazı virüsler kendini Windows Görev Yöneticisi'nden gizler. Bu sayfa çalışan işlemleri birbirinden bağımsız birkaç yöntemle sayar ve karşılaştırır: bir yöntemde görünüp Windows'un listesinde görünmeyen işlem gizleniyor demektir. Ayrıca imzasız, garip yerlerden çalışan ya da sistem dosyası taklidi yapan programları işaretler." />

            <!-- Verdict -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="18" Height="18" Fill="{Binding VerdictLevel, Converter={StaticResource RiskBrush}}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Verdict}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastScan}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding MethodNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding MethodNote, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="Program yönetici olarak çalışmıyor; korumalı işlemler görülemeyebilir. Programı sağ tıklayıp 'Yönetici olarak çalıştır' deyin."
                                   Foreground="#F5A524" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Şimdi tara" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding ScanCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
            <ui:ProgressRing IsIndeterminate="True" Height="24" Width="24" HorizontalAlignment="Left" Margin="0,0,0,12"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Hidden processes -->
            <TextBlock Text="GİZLENEN İŞLEMLER" Style="{StaticResource CardTitle}" Margin="0,4,0,8" />
            <TextBlock Text="Bulunamadı. Her tarama sonucunda tutarsızlık olup olmadığı burada gösterilir." Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding HasHidden, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding HiddenFindings}" ItemTemplate="{StaticResource FindingTemplate}" />

            <!-- Risky processes -->
            <TextBlock Text="DİKKAT İSTEYEN ÇALIŞAN PROGRAMLAR" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
            <TextBlock Text="Orta ya da yüksek riskli çalışan program yok." Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding HasRisky, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding RiskyProcesses}" ItemTemplate="{StaticResource FindingTemplate}" />

            <!-- Honest limits -->
            <ui:InfoBar Title="Bu araç neyi yapabilir, neyi yapamaz?" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                        Message="Kendini kullanıcı seviyesinde gizleyen ve sistem dosyası taklidi yapan zararlıların çoğunu yakalar. Windows çekirdeğine yerleşmiş gelişmiş rootkit'ler ise her programdan (bu dahil) saklanabilir. 'Risk' bir tahmindir, kesin teşhis değildir: şüpheli bir şey görürseniz VirusTotal ile kontrol edin ve Microsoft Defender ile tam tarama yapın." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
