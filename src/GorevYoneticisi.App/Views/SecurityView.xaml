<UserControl x:Class="GorevYoneticisi.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="FindingTemplate">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="4" CornerRadius="2" Margin="0,0,12,0" Background="{Binding Level, Converter={StaticResource RiskBrush}}" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    BorderThickness="1" BorderBrush="{Binding Level, Converter={StaticResource RiskBrush}}">
                                <TextBlock Text="{Binding Level, Converter={StaticResource RiskText}}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,6,0,0"
                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Body}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0" MinWidth="150">
                        <ui:Button Content="İşlemlerde göster" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                   Command="{Binding DataContext.ShowInProcessesCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        <ui:Button Content="VirusTotal'de ara" HorizontalAlignment="Stretch"
                                   ToolTip="Dosyanın parmak izi ile VirusTotal tarayıcıda açılır; dosyanın kendisi gönderilmez."
                                   Command="{Binding DataContext.VirusTotalCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,16">
            <TextBlock Text="Güvenlik" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Bazı virüsler kendini Görev Yöneticisi'nden gizler. Bu sayfa çalışan programları birkaç farklı yolla sayıp sonuçları karşılaştırır: bir yolda görünüp Windows'un listesinde görünmeyen program kendini saklıyor olabilir. Ayrıca imzasız, alışılmadık klasörlerden çalışan ya da Windows dosyası gibi görünen programları işaretler." />

            <!-- Verdict -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="18" Height="18" Fill="{Binding VerdictLevel, Converter={StaticResource RiskBrush}}" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Verdict}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Visibility="{Binding VerdictDetail, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding LastScan}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding MethodNote}" Style="{StaticResource WarningText}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding MethodNote, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <ui:Button Content="Şimdi tara" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ScanCommand}" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <ui:ProgressRing IsIndeterminate="True" Height="16" Width="16" Margin="0,0,8,0" />
                            <TextBlock Text="Taranıyor… (birkaç saniye)" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                       Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

            <!-- What should I do? -->
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="{Binding ShowAdvice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Ne yapmalıyım?" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="1. Programı tanıyorsanız (ör. bir oyunun, yazıcının ya da ekran kartının yazılımı) büyük olasılıkla sorun yoktur." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="2. Tanımıyorsanız &quot;VirusTotal'de ara&quot; düğmesine basın; 70'ten fazla antivirüsün görüşünü gösterir." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="3. Şüpheniz sürerse Windows Güvenliği'nde &quot;Microsoft Defender Çevrimdışı tarama&quot; çalıştırın." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="4. Emin olmadan Windows'a ait programları sonlandırmayın." />
                    <ui:Button Content="Windows Güvenliği'ni aç" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding OpenWindowsSecurityCommand}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Hidden programs -->
            <TextBlock Text="GİZLENEN PROGRAMLAR" Style="{StaticResource CardTitle}" Margin="0,4,0,8" />
            <TextBlock Text="Gizlenen program bulunmadı. Bu bölüm her taramadan sonra güncellenir." Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding HasHidden, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding HiddenFindings}" ItemTemplate="{StaticResource FindingTemplate}" />

            <!-- Risky programs -->
            <TextBlock Text="DİKKAT GEREKTİREN PROGRAMLAR" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
            <TextBlock Text="Şu an dikkat gerektiren bir program çalışmıyor." Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding HasRisky, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding RiskyProcesses}" ItemTemplate="{StaticResource FindingTemplate}" />

            <!-- Honest limits -->
            <ui:InfoBar Title="Bu araç neyi yapabilir, neyi yapamaz?" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                        Message="Kendini Windows listelerinden gizleyen ve Windows dosyası gibi görünen zararlıların çoğunu yakalar. Windows'un en derinine (çekirdeğe) yerleşmiş gelişmiş zararlılar ise her programdan, bundan da, saklanabilir. Risk bir tahmindir, kesin teşhis değildir." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
