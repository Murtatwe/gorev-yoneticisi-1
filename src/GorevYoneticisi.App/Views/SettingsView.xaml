<UserControl x:Class="GorevYoneticisi.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Değişiklikler hemen uygulanır ve kaydedilir." Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Yenileme hızı" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Verilerin ne sıklıkla güncelleneceği. Daha hızlı = biraz daha fazla işlemci kullanımı." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding Refresh}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Gizli işlem taraması" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Arka planda ne sıklıkla tarama yapılacağı. Güvenlik sayfasından istediğiniz an elle de tarayabilirsiniz." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ScanOptions}" SelectedItem="{Binding Scan}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tema" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Koyu, açık ya da Windows ayarına uyan tema." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Her zaman üstte" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Pencere diğer programların üstünde kalır (ör. oyun oynarken kullanımı izlemek için)." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Hakkında" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Görev Yöneticisi sürüm " /><Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text=" · Ayarlar ve hata kaydı: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Bir sorun yaşarsanız bu klasördeki hata.log dosyasını paylaşın." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Klasörü aç" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Yeni sürümler" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
