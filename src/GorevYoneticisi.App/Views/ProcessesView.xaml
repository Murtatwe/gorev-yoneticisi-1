<UserControl x:Class="GorevYoneticisi.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:u="clr-namespace:GorevYoneticisi.App.Ui"
             x:Name="Root">
    <UserControl.Resources>
        <u:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <DataTemplate x:Key="TwoLineHeader">
            <TextBlock Text="{Binding}" TextAlignment="Right" HorizontalAlignment="Stretch" LineHeight="16" />
        </DataTemplate>

        <ContextMenu x:Key="RowMenu" DataContext="{Binding Data, Source={StaticResource Proxy}}">
            <MenuItem Header="Görevi sonlandır" InputGestureText="Del" Command="{Binding KillCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="İşlem ağacını sonlandır" Command="{Binding KillTreeCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="TextBulletListTree24" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Dosya konumunu aç" Command="{Binding OpenLocationCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Çevrimiçi ara" Command="{Binding SearchOnlineCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Globe24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="VirusTotal'de ara" Command="{Binding VirusTotalCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ShieldCheckmark24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Yolu kopyala" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Özellikler" Command="{Binding PropertiesCommand}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="İşlemler" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Çalışan her programın ne kadar kaynak kullandığı. Sıralamak için sütun başlığına, ayrıntılar için bir satıra tıklayın; sağ tık ile daha fazla seçenek." />
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" LastChildFill="False">
            <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="280" PlaceholderText="Ara (Ctrl+F)…"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Search24}"
                        ToolTip="Ad, PID, yol ya da yayımcı ile arayın. Esc ile temizleyin." />
            <CheckBox DockPanel.Dock="Left" Content="Uygulamaya göre grupla" IsChecked="{Binding GroupByApp}" Margin="16,0,0,0" VerticalAlignment="Center"
                      ToolTip="Aynı programın tüm kopyalarını (ör. tarayıcı sekmeleri) tek satırda toplar." />
            <CheckBox DockPanel.Dock="Left" Content="Yalnızca dikkat isteyenler" IsChecked="{Binding OnlyRisky}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid x:Name="Grid" Grid.Row="2" Grid.Column="0"
                  ItemsSource="{Binding View}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" ColumnHeaderHeight="48"
                  RowHeight="30" ContextMenu="{StaticResource RowMenu}" HorizontalScrollBarVisibility="Auto"
                  PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding KillCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <!-- Columns mirror the DataGrid columns below so the sums line up. -->
                                            <ToggleButton x:Name="Toggle" Style="{StaticResource GroupHeaderToggle}" Click="GroupHeader_Click"
                                                          ToolTip="Tıklayınca bu uygulamanın işlemleri açılır">
                                                <Grid DataContext="{Binding Name}" Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="160" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronRight16" FontSize="12" Margin="2,0,4,0" RenderTransformOrigin="0.5,0.5">
                                                            <ui:SymbolIcon.RenderTransform><RotateTransform Angle="0" /></ui:SymbolIcon.RenderTransform>
                                                        </ui:SymbolIcon>
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Risk, Converter={StaticResource RiskBrushHideNone}}" />
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        <ui:SymbolIcon Symbol="Warning16" Margin="6,0,0,0" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                                                       Visibility="{Binding Risk, Converter={StaticResource RiskWarningVisibility}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding Cpu, Converter={StaticResource Heat}, ConverterParameter=50}">
                                                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{Binding MemoryPercent, Converter={StaticResource Heat}, ConverterParameter=15}">
                                                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="3" Background="{Binding Gpu, Converter={StaticResource Heat}, ConverterParameter=60}">
                                                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Grid.Column="4" Background="{Binding Io, Converter={StaticResource Heat}, ConverterParameter=50000000}">
                                                        <TextBlock Text="{Binding IoText}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsPresenter Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="Toggle" Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Ad" Width="*" MinWidth="160" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource RiskDot}" Width="8" Height="8" Margin="2,0,6,0"
                                         Fill="{Binding Risk, Converter={StaticResource RiskBrushHideNone}}" ToolTip="{Binding Risk, Converter={StaticResource RiskText}}" />
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ui:SymbolIcon Symbol="Warning16" Margin="6,0,0,0" Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                               Visibility="{Binding Risk, Converter={StaticResource RiskWarningVisibility}}"
                                               ToolTip="{Binding Risk, Converter={StaticResource RiskText}}" />
                                <Border Background="#E5484D" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="GİZLİ" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="64" MinWidth="64" SortMemberPath="Cpu" SortDirection="Descending"
                                        Header="{Binding Data.CpuHeader, Source={StaticResource Proxy}}" HeaderTemplate="{StaticResource TwoLineHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Cpu, Converter={StaticResource Heat}, ConverterParameter=50}" Margin="-1">
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource NumberCell}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="84" MinWidth="84" SortMemberPath="Memory"
                                        Header="{Binding Data.MemoryHeader, Source={StaticResource Proxy}}" HeaderTemplate="{StaticResource TwoLineHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding MemoryPercent, Converter={StaticResource Heat}, ConverterParameter=15}" Margin="-1"
                                    ToolTip="Programın kendine ayırdığı RAM (Windows Görev Yöneticisi'ndeki 'Bellek' ile aynı).">
                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource NumberCell}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="60" MinWidth="60" SortMemberPath="Gpu"
                                        Header="{Binding Data.GpuHeader, Source={StaticResource Proxy}}" HeaderTemplate="{StaticResource TwoLineHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Gpu, Converter={StaticResource Heat}, ConverterParameter=60}" Margin="-1">
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource NumberCell}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="84" MinWidth="84" SortMemberPath="Io"
                                        Header="{Binding Data.IoHeader, Source={StaticResource Proxy}}" HeaderTemplate="{StaticResource TwoLineHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Io, Converter={StaticResource Heat}, ConverterParameter=50000000}" Margin="-1"
                                    ToolTip="Programın saniyede okuduğu ve yazdığı veri (disk ve ağ paylaşımları dahil).">
                                <TextBlock Text="{Binding IoText}" Style="{StaticResource NumberCell}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="GPU bellek" Binding="{Binding GpuMemoryText}" SortMemberPath="GpuMemory" Width="80" MinWidth="80"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="56" MinWidth="56" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Yayımcı" Binding="{Binding Signature}" Width="140" MinWidth="140" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Details (only when something is selected) -->
        <Border x:Name="DetailsPanel" Grid.Row="2" Grid.Column="1" Style="{StaticResource Panel}" Margin="12,0,0,0" Width="320"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Selected}" Margin="0,0,28,0">
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="4"
                                   Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Kapat" Click="CloseDetails_Click" />
                    </Grid>

                    <StackPanel DataContext="{Binding Selected}">
                        <Border CornerRadius="6" Padding="10,6" Margin="0,12,0,0" BorderThickness="1"
                                BorderBrush="{Binding Risk, Converter={StaticResource RiskBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Risk, Converter={StaticResource RiskText}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Body}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DOSYA YOLU" Style="{StaticResource CardTitle}" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding Path, TargetNullValue='(okunamadı)'}" Style="{StaticResource Body}" />

                        <TextBlock Text="YAYIMCI (DİJİTAL İMZA)" Style="{StaticResource CardTitle}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding Signature}" Style="{StaticResource Body}" />

                        <TextBlock Text="BAŞLAMA ZAMANI" Style="{StaticResource CardTitle}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding StartedText, Mode=OneWay}" Style="{StaticResource Body}" />
                    </StackPanel>

                    <TextBlock Text="BAŞLATAN PROGRAM" Style="{StaticResource CardTitle}" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding ParentText, Mode=OneWay}" Style="{StaticResource Body}" />

                    <TextBlock Text="KOMUT SATIRI" Style="{StaticResource CardTitle}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" DataContext="{Binding Selected}"
                               ToolTip="İş parçacığı: programın aynı anda yürüttüğü iş sayısı. Tutamaç: programın açık tuttuğu dosya, kayıt anahtarı gibi nesneler.">
                        <Run Text="PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding Threads, Mode=OneWay}" /><Run Text=" iş parçacığı · " />
                        <Run Text="{Binding Handles, Mode=OneWay}" /><Run Text=" tutamaç" />
                    </TextBlock>

                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Content="Dosya konumunu aç" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLocationCommand}" Margin="0,0,6,6" />
                        <ui:Button Content="VirusTotal'de ara" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding VirusTotalCommand}" Margin="0,0,6,6"
                                   ToolTip="Dosyanın SHA-256 parmak izi hesaplanır ve VirusTotal tarayıcıda açılır. Dosyanın kendisi gönderilmez." />
                        <ui:Button Content="Çevrimiçi ara" Icon="{ui:SymbolIcon Globe24}" Command="{Binding SearchOnlineCommand}" Margin="0,0,6,6" />
                        <ui:Button Content="Görevi sonlandır" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Danger" Command="{Binding KillCommand}" Margin="0,0,6,6"
                                   ToolTip="Del" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
