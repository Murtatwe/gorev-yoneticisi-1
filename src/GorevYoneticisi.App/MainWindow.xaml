<ui:FluentWindow x:Class="GorevYoneticisi.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:GorevYoneticisi.App.ViewModels"
                 xmlns:views="clr-namespace:GorevYoneticisi.App.Views"
                 xmlns:u="clr-namespace:GorevYoneticisi.App.Ui"
                 Title="Görev Yöneticisi"
                 Width="1280" Height="820" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><views:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityViewModel}"><views:SecurityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Title="Görev Yöneticisi" />

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="12,4,8,8" LastChildFill="False">
            <ListBox DockPanel.Dock="Top"
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Security status at the bottom of the sidebar -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource RiskDot}" Fill="{Binding SecurityLevel, Converter={StaticResource RiskBrush}}" Margin="0,0,8,0" />
                        <TextBlock Text="Güvenlik" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SecurityStatus}" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock Text="Yönetici izni yok: bazı işlemler görünmeyebilir." Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}"
                               Foreground="{x:Static u:RiskColors.Medium}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Page -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="8,4,20,8" Focusable="False" />

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,6">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
        </Border>
    </Grid>
</ui:FluentWindow>
